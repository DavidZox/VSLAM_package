# Local from-source install prefix (regenerated by building g2o/stella_vslam)
/local_install/

# Viewer deps, cloned directly for now (TODO: formalize as forked submodules like
# g2o/stella_vslam/stella_vslam_examples/stella_vslam_ros once the viewer is confirmed working)
/pangolin/
/pangolin_viewer/

# Downloaded runtime assets (re-downloadable, not project source)
/vocab/
/datasets/
/vslam_bringup/vocab/

# Build logs
*_build.log

# g2o Cholesky-failure debug dump (written to cwd whenever a solve fails; harmless, regenerated)
debug.txt

# Generic build directories
build/

# Python bytecode cache (generated by py_compile / running the launch files)
__pycache__/
install/
log/
